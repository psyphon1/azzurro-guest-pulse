# local data (sample data is committed on purpose, see data/sample_*)
data/raw/
data/*.db-journal
# Databases: the collected data (data/reviews.db) and its snapshot (data/sample/reviews_sample.db) are committed on
# purpose so the submitted repo runs on real data. They hold real public Booking.com review text. Other .db files
# (demo data, test copies) stay out.
data/*.db
!data/reviews.db
!data/sample/
data/sample/*.db
!data/sample/reviews_sample.db
.DS_Store
data/demo.db
data/audit_shots/
data/.collect.lock
data/.collect.status.json
data/collect.log
